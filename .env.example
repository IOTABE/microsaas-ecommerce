# DATABASE (PostgreSQL com suporte a RLS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/microsaas_db?schema=public"

# AUTH & JWT
JWT_SECRET="super-secret-jwt-key-change-in-production"

# GATEWAY DE PAGAMENTO (Mercado Pago / Asaas / Stripe)
PAYMENT_GATEWAY_PROVIDER="mercadopago"
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# WHATSAPP MESSAGING (Meta Cloud API ou Evolution API)
WHATSAPP_PROVIDER="meta_cloud"
WHATSAPP_API_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="10987654321"

# E-MAIL (Resend / SendGrid / SMTP)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@meusaas.com"
